    {
      "name": "4. Incremental sync",
      "item": [
        {
          "name": "Newest since lastId (run twice: 2nd returns 0 new)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Each run saves lastId from the response into the collection variable, mimicking a CRM sync job.",
            "url": {
              "raw": "{{baseUrl}}/api/crm/leads/space-booking?since_id={{lastId}}&limit=500",
              "host": [
                "{{baseUrl}}"
              ],
