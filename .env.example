PORT=4010

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wellness_india_expo

# Comma-separated list of origins allowed to call this API
# http://localhost:8080 -> static html/ folder, http://localhost:3010 -> latest (Next.js dev/start)
CORS_ORIGIN=http://localhost:8080,http://localhost:3010

# From https://www.google.com/recaptcha/admin — leave blank to skip captcha verification
# (space-booking submissions are accepted without it until this is set).
RECAPTCHA_SECRET_KEY=

# SMTP settings for the "thanks for registering"/"thanks for your enquiry" confirmation
# emails sent on every marketing-site form submission (space booking, visitor/speaker/media
# registration, hosted buyer, newsletter). Leave SMTP_HOST blank to skip sending emails
# entirely — submissions are still accepted and saved either way, and nothing ever surfaces
# a mail failure to the person submitting the form (see src/lib/mailer.js).
#
# Production (this server runs its own local Postfix relay on port 25, no auth/TLS needed
# since Node -> Postfix is a loopback hop; Postfix + OpenDKIM handle outbound delivery):
#   SMTP_HOST=127.0.0.1
#   SMTP_PORT=25
#   SMTP_SECURE=false
#   SMTP_USER=            (leave blank — no auth against localhost:25)
#   SMTP_PASS=            (leave blank)
#   SMTP_FROM="Wellness India Expo" <noreply@wellnessindiaexpo.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Visitor registration OTP (mobile/email verification). Currently mocked — every OTP
# request accepts OTP_MOCK_CODE regardless of channel, since no SMS/email OTP gateway is
# wired up yet. Swap this for a real gateway by replacing src/lib/otpStore.js's send()
# internals; the rate limiting / expiry / attempt-limiting logic can stay as-is.
OTP_MOCK_CODE=1234
OTP_TTL_MINUTES=10
OTP_SEND_WINDOW_MINUTES=15
OTP_MAX_SENDS=5
OTP_MAX_VERIFY_ATTEMPTS=5

# ---- Exhibitor Zone (auth+RBAC portal, same wellness_india_expo database as above) ----
# AES-256-GCM key (64 hex chars / 32 bytes) for encrypted PII columns (gst_number_enc, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
SESSION_COOKIE_NAME=ez_session
SESSION_TTL_DAYS=7
# Local-disk storage only (company documents, form attachments) — no S3/GCS wired up.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# Used to build the password-reset link emailed to exhibitor users.
FRONTEND_BASE_URL=http://localhost:3010
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
